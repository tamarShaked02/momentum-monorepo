datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String              @id @default(uuid())
  email            String              @unique
  password         String
  businessName     String?
  businessType     String?
  telegramBotToken String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  moduleConfig     ModuleConfig?
  customers        Customer[]
  appointments     Appointment[]
  inventoryItems   InventoryItem[]
  tasks            Task[]
  campaigns        MarketingCampaign[]
  googleCalendarTokens GoogleCalendarToken?
  pipelines        Pipeline[]
  deals            Deal[]
  tags             Tag[]
  customFields     CustomField[]
  automationRules  AutomationRule[]
  activities       Activity[]
}

model ModuleConfig {
  id                String  @id @default(uuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedulingEnabled Boolean @default(false)
  crmEnabled        Boolean @default(false)
  inventoryEnabled  Boolean @default(false)
  tasksEnabled      Boolean @default(false)
  marketingEnabled  Boolean @default(false)
  analyticsEnabled  Boolean @default(false)
}

model Customer {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String             @db.VarChar(200)
  email           String?            @db.VarChar(254)
  phone           String?            @db.VarChar(30)
  telegramChatId  String?
  notes           String?            @db.VarChar(5000)
  company         String?            @db.VarChar(200)
  jobTitle        String?            @db.VarChar(200)
  leadSource      String?            @db.VarChar(100)
  lifecycleStage  String             @default("lead")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  appointments    Appointment[]
  deals           Deal[]
  activities      Activity[]
  tags            ContactTag[]
  customFieldValues CustomFieldValue[]
  linkedTasks     Task[]             @relation("ContactTasks")
}

model Appointment {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  title      String
  startTime  DateTime
  endTime    DateTime
  status     String    @default("scheduled")
  source     String    @default("manual")
  price      Float?
  googleEventId String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model GoogleCalendarToken {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String
  syncToken    String?
  calendarId   String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model InventoryItem {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  sku          String?
  quantity     Int                @default(0)
  lowThreshold Int                @default(5)
  price        Float?
  category     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  history      InventoryHistory[]
  dealItems    DealItem[]
}

model InventoryHistory {
  id              String        @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  changeType      String
  quantityChange  Int
  previousQty     Int
  newQty          Int
  note            String?
  createdAt       DateTime      @default(now())
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(200)
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  category    String?
  dueDate     DateTime?
  contactId   String?
  contact     Customer? @relation("ContactTasks", fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?     @relation("DealTasks", fields: [dealId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MarketingCampaign {
  id                      String    @id @default(uuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  goal                    String?
  status                  String    @default("draft")
  channels                String[]
  smsContent              String?
  emailContent            String?
  socialContent           String?
  imageUrl                String?
  audienceTags            String[]
  audienceLifecycleStages String[]
  scheduledAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Tag {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String       @db.VarChar(100)
  color     String?      @db.VarChar(7)
  createdAt DateTime     @default(now())
  contacts  ContactTag[]

  @@unique([userId, name])
}

model ContactTag {
  id         String   @id @default(uuid())
  contactId  String
  contact    Customer @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([contactId, tagId])
}

model CustomField {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String            @db.VarChar(100)
  fieldType String
  options   String[]
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  values    CustomFieldValue[]
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Customer    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  value         String      @db.VarChar(1000)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([customFieldId, contactId])
}

model Pipeline {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(100)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stages    Stage[]
  deals     Deal[]
}

model Stage {
  id         String   @id @default(uuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(50)
  position   Int
  isTerminal Boolean  @default(false)
  dealStatus String?
  createdAt  DateTime @default(now())
  deals      Deal[]

  @@unique([pipelineId, position])
}

model Deal {
  id                String     @id @default(uuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String     @db.VarChar(200)
  value             Float?
  expectedCloseDate DateTime?
  winProbability    Int?
  pipelineId        String
  pipeline          Pipeline   @relation(fields: [pipelineId], references: [id])
  stageId           String
  stage             Stage      @relation(fields: [stageId], references: [id])
  contactId         String
  contact           Customer   @relation(fields: [contactId], references: [id])
  status            String     @default("open")
  closedAt          DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  activities        Activity[]
  items             DealItem[]
  linkedTasks       Task[]     @relation("DealTasks")
}

model DealItem {
  id              String        @id @default(uuid())
  dealId          String
  deal            Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Int
  unitPrice       Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([dealId, inventoryItemId])
}

model Activity {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  description String?   @db.VarChar(5000)
  metadata    Json?
  contactId   String?
  contact     Customer? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AutomationRule {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String              @db.VarChar(200)
  trigger   Json
  actions   Json
  enabled   Boolean             @default(true)
  position  Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  logs      AutomationRuleLog[]
}

model AutomationRuleLog {
  id         String         @id @default(uuid())
  ruleId     String
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  success    Boolean
  actionType String
  error      String?
  metadata   Json?
  createdAt  DateTime       @default(now())
}
