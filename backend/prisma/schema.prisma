generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  password             String
  businessName         String?
  businessType         String?
  phone                String?
  telegramChatId       String?
  telegramBotToken     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  activities           Activity[]
  appointments         Appointment[]
  automationRules      AutomationRule[]
  customFields         CustomField[]
  customers            Customer[]
  deals                Deal[]
  googleCalendarTokens GoogleCalendarToken?
  inventoryItems       InventoryItem[]
  campaigns            MarketingCampaign[]
  moduleConfig         ModuleConfig?
  pipelines            Pipeline[]
  tags                 Tag[]
  tasks                Task[]
}

model ModuleConfig {
  id                String  @id @default(uuid())
  userId            String  @unique
  schedulingEnabled Boolean @default(false)
  crmEnabled        Boolean @default(false)
  inventoryEnabled  Boolean @default(false)
  tasksEnabled      Boolean @default(false)
  marketingEnabled  Boolean @default(false)
  analyticsEnabled  Boolean @default(false)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id                String             @id @default(uuid())
  userId            String
  name              String             @db.VarChar(200)
  email             String?            @db.VarChar(254)
  phone             String?            @db.VarChar(30)
  telegramChatId    String?
  notes             String?            @db.VarChar(5000)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           String?            @db.VarChar(200)
  jobTitle          String?            @db.VarChar(200)
  leadSource        String?            @db.VarChar(100)
  lifecycleStage    String             @default("lead")
  activities        Activity[]
  appointments      Appointment[]
  tags              ContactTag[]
  customFieldValues CustomFieldValue[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals             Deal[]
  linkedTasks       Task[]             @relation("ContactTasks")
}

model Appointment {
  id            String    @id @default(uuid())
  userId        String
  customerId    String?
  title         String
  startTime     DateTime
  endTime       DateTime
  status        String    @default("scheduled")
  source        String    @default("manual")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  price         Float?
  googleEventId String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleCalendarToken {
  id           String    @id @default(uuid())
  userId       String    @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String
  syncToken    String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  calendarId   String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id           String             @id @default(uuid())
  userId       String
  name         String
  sku          String?
  quantity     Int                @default(0)
  lowThreshold Int                @default(5)
  price        Float?
  category     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  dealItems    DealItem[]
  history      InventoryHistory[]
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InventoryHistory {
  id              String        @id @default(uuid())
  inventoryItemId String
  changeType      String
  quantityChange  Int
  previousQty     Int
  newQty          Int
  note            String?
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  title       String    @db.VarChar(200)
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  category    String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contactId   String?
  dealId      String?
  contact     Customer? @relation("ContactTasks", fields: [contactId], references: [id])
  deal        Deal?     @relation("DealTasks", fields: [dealId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarketingCampaign {
  id                      String    @id @default(uuid())
  userId                  String
  name                    String
  goal                    String?
  status                  String    @default("draft")
  channels                String[]
  smsContent              String?
  emailContent            String?
  socialContent           String?
  telegramContent         String?
  imageUrl                String?
  scheduledAt             DateTime?
  lastSentAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  audienceLifecycleStages String[]
  audienceTags            String[]
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String       @id @default(uuid())
  userId    String
  name      String       @db.VarChar(100)
  color     String?      @db.VarChar(7)
  createdAt DateTime     @default(now())
  contacts  ContactTag[]
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model ContactTag {
  id         String   @id @default(uuid())
  contactId  String
  tagId      String
  assignedAt DateTime @default(now())
  contact    Customer @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
}

model CustomField {
  id        String             @id @default(uuid())
  userId    String
  name      String             @db.VarChar(100)
  fieldType String
  options   String[]
  position  Int                @default(0)
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  customFieldId String
  contactId     String
  value         String      @db.VarChar(1000)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  contact       Customer    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, contactId])
}

model Pipeline {
  id        String   @id @default(uuid())
  userId    String
  name      String   @db.VarChar(100)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals     Deal[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages    Stage[]
}

model Stage {
  id         String   @id @default(uuid())
  pipelineId String
  name       String   @db.VarChar(50)
  position   Int
  isTerminal Boolean  @default(false)
  dealStatus String?
  createdAt  DateTime @default(now())
  deals      Deal[]
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, position])
}

model Deal {
  id                String     @id @default(uuid())
  userId            String
  title             String     @db.VarChar(200)
  value             Float?
  expectedCloseDate DateTime?
  winProbability    Int?
  pipelineId        String
  stageId           String
  contactId         String
  status            String     @default("open")
  closedAt          DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  activities        Activity[]
  contact           Customer   @relation(fields: [contactId], references: [id])
  pipeline          Pipeline   @relation(fields: [pipelineId], references: [id])
  stage             Stage      @relation(fields: [stageId], references: [id])
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             DealItem[]
  linkedTasks       Task[]     @relation("DealTasks")
}

model DealItem {
  id              String        @id @default(uuid())
  dealId          String
  inventoryItemId String
  quantity        Int
  unitPrice       Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deal            Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([dealId, inventoryItemId])
}

model Activity {
  id          String    @id @default(uuid())
  userId      String
  type        String
  description String?   @db.VarChar(5000)
  metadata    Json?
  contactId   String?
  dealId      String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contact     Customer? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AutomationRule {
  id        String              @id @default(uuid())
  userId    String
  name      String              @db.VarChar(200)
  trigger   Json
  actions   Json
  enabled   Boolean             @default(true)
  position  Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      AutomationRuleLog[]
}

model AutomationRuleLog {
  id         String         @id @default(uuid())
  ruleId     String
  success    Boolean
  actionType String
  error      String?
  metadata   Json?
  createdAt  DateTime       @default(now())
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}
