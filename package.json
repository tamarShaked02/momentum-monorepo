{
  "name": "momentum-monorepo",
  "version": "1.0.0",
  "description": "Momentum AI Onboarding Monorepo",
  "type": "module",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=services/core",
    "dev": "npm run dev --workspace=services/core",
    "start:core": "npm run start --workspace=services/core",
    "dev:core": "npm run dev --workspace=services/core",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "monorepo",
    "microservices",
    "ai",
    "onboarding"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
